# Base directory holding archived sites. Each crawl creates <host>/ below it,
# containing exactly two folders: report/ and raw-html/.
OUTPUT_FOLDER=./archive

# User-Agent used for discovery requests, robots.txt matching and the browser.
# USER_AGENT=WebArchiver/1.0 (+https://github.com/your-org/web-archiver)

# Directory of the capture engine that drives the browser. It is vendored into
# this repository at vendor/capture-engine, so this only needs setting if you
# moved it. The old SINGLEFILE_DIR name still works.
# CAPTURE_ENGINE_DIR=D:\MCP\web-archiver\vendor\capture-engine

# Chrome/Chromium/Edge executable for SingleFile to drive. When unset,
# SingleFile auto-detects an installed browser.
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# How long SingleFile waits for lazy-loaded images, per page, in ms. Its own
# default is 1500; 500 measured ~28% faster with byte-identical output on
# sites that do not lazy-load heavily. Raise it for image-heavy sites.
# DEFERRED_IMAGES_MAX_IDLE_MS=500

# Retry behaviour for discovery requests.
# MAX_RETRIES=3
# RETRY_DELAY_MS=1000
