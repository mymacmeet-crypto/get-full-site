# Base directory holding archived sites. Each crawl creates <host>/ below it,
# containing report/, raw-html/ and - once the crawl downloads a linked file -
# assets/.
OUTPUT_FOLDER=./archive

# User-Agent used for discovery requests, robots.txt matching and the browser.
# USER_AGENT=WebArchiver/1.0 (+https://github.com/your-org/web-archiver)

# Directory of the capture engine that drives the browser. It is vendored into
# this repository at vendor/capture-engine, so this only needs setting if you
# moved it. The old SINGLEFILE_DIR name still works.
# CAPTURE_ENGINE_DIR=D:\MCP\web-archiver\vendor\capture-engine

# Chrome/Chromium/Edge executable for SingleFile to drive. When unset,
# SingleFile auto-detects an installed browser.
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Settling time after a page loads and before it is captured, in ms. Defaults
# to 600 while the reveal pass is on (below) and 0 without it. Raise it for
# sites that render their content with JavaScript; it is wall-clock spent on
# every batch, so only pay it where it is needed.
# WAIT_AFTER_LOAD_MS=600

# How long the engine waits for lazy-loaded images, per page, in ms. Its own
# default is 1500; 500 measured ~28% faster with byte-identical output on
# sites that do not lazy-load heavily. Raise it for image-heavy sites.
# DEFERRED_IMAGES_MAX_IDLE_MS=500

# Retry behaviour for discovery requests. Asset downloads use these too.
# MAX_RETRIES=3
# RETRY_DELAY_MS=1000

# ---------------------------------------------------------------------------
# Linked files (PDFs, spreadsheets, archives)
# ---------------------------------------------------------------------------

# Which file types to download alongside pages. Groups: documents, archives,
# media, code. Also accepts bare extensions, "all" and "none". Comma-separated.
# The CLI's --assets overrides this.
# ASSET_TYPES=documents

# Which hosts linked files may come from:
#   same   - only the host being crawled
#   linked - that host, plus other hosts a crawled page links directly (a PDF
#            on a CDN or an S3 bucket still gets taken)
#   any    - any host at all
# ASSET_DOMAINS=linked

# Ceilings on the asset pipeline. A file larger than the limit is skipped and
# named in the report rather than half-downloaded.
# MAX_ASSETS=1000
# MAX_ASSET_SIZE_MB=100
# ASSET_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Capture fidelity
# ---------------------------------------------------------------------------

# Text that animates in on scroll sits at opacity 0 until it is scrolled into
# view, and a headless capture never scrolls - so it is missing from the saved
# file. The reveal pass scrolls each page before capturing it. Set to 0 to turn
# it off (same as --no-reveal-animations).
# REVEAL_ANIMATIONS=1

# Time budget for that scroll, per page. Raise it for very long pages; the
# scroll overlaps page load, so most of it costs no extra wall-clock.
# REVEAL_SCROLL_MS=4000
