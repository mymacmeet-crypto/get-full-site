{
  "name": "web-archiver",
  "version": "1.0.0",
  "description": "Crawl a domain and archive every selected page as a standalone HTML file, driving a vendored capture engine in-process",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "main": "src/crawler.js",
  "bin": {
    "web-archiver": "bin/archive.js",
    "web-archiver-dataset": "bin/dataset.js"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "start": "node bin/archive.js",
    "archive": "pwsh -NoProfile -ExecutionPolicy Bypass -File runner.ps1",
    "archive:sh": "bash runner.sh",
    "test": "node --test \"test/**/*.test.js\"",
    "dataset": "node bin/dataset.js"
  },
  "keywords": [
    "crawler",
    "archiver",
    "singlefile",
    "website-mirror",
    "offline"
  ],
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
